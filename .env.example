# Configuração do Servidor
PORT=3333
NODE_ENV=development
APP_NAME=Colupe API

# URL pública da API para consumo do Frontend
PUBLIC_API_URL=http://localhost:3333

# Banco de Dados (PostgreSQL / Supabase Transaction Pooler - Porta 6543)
DATABASE_URL=postgresql://postgres.xxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Cloudflare Tunnel (Produção)
CLOUDFLARE_TUNNEL_TOKEN=
