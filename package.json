{
  "name": "colupe",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter \"*\" dev",
    "dev:api": "bun --filter @colupe/api dev",
    "dev:web": "bun --filter @colupe/web dev",
    "dev:site": "bun --filter @colupe/site dev",
    "build": "bun --filter \"*\" build"
  }
}
